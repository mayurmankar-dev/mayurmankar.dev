---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate } from '../utils/posts';
import { EMAIL } from '../consts';

const recentPosts = (await getPosts()).slice(0, 3);

const person = {
  '@type': 'Person',
  // Stable ID so other sites (careerbonus.co's Organization.founder) can refer to this same person.
  '@id': 'https://mayurmankar.dev/#person',
  name: 'Mayur Mankar',
  url: 'https://mayurmankar.dev',
  image: 'https://mayurmankar.dev/images/profile-photo-400.jpg',
  email: `mailto:${EMAIL}`,
  jobTitle: 'Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Spindle Quantum', url: 'https://spindlequantum.com' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Science Education and Research Bhopal' },
  sameAs: [
    'https://github.com/mayurmankar-dev',
    'https://www.linkedin.com/in/mayurmankar',
    'https://x.com/mayurmankar_dev',
    'https://www.researchgate.net/profile/Mayur-Mankar-2',
  ],
};

// WebSite tells Google which name to show for the site in results ("site name").
const website = {
  '@type': 'WebSite',
  '@id': 'https://mayurmankar.dev/#website',
  url: 'https://mayurmankar.dev/',
  name: 'Mayur Mankar',
  publisher: { '@id': 'https://mayurmankar.dev/#person' },
};
const structuredData = { '@context': 'https://schema.org', '@graph': [website, person] };
---
<Base fullTitle="Mayur Mankar | Software Engineer, AI & Cloud">
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />

        <!-- Name tab -->
        <header class="intro">
            <a class="intro-photo" href="/images/profile-photo-800.jpg"><img alt="Mayur Mankar" src="/images/profile-photo-400.jpg" width="400" height="400" fetchpriority="high" class="img-circle profile-photo"></a>
            <div class="intro-text">
                <h1 class="intro-name">Mayur Mankar</h1>
                <p class="nav-links">
                    <a href="/blog/">Blog</a> &nbsp;|&nbsp;
                    <a href="#news">News</a> &nbsp;|&nbsp;
                    <a href="#skills">Skills</a> &nbsp;|&nbsp;
                    <a href="#work">Work</a> &nbsp;|&nbsp;
                    <a href="#research">Research</a> &nbsp;|&nbsp;
                    <a href="#publications">Publications</a> &nbsp;|&nbsp;
                    <a href="#projects">Projects</a> &nbsp;|&nbsp;
                    <a href="mailto:mayurmankar.dev@gmail.com">Contact</a>
                </p>
            </div>
        </header>

        <!-- About section, quick links -->
        <section class="about">
            <p>I am a Software Engineer (SDE-I) at <a href="https://spindlequantum.com" target="_blank">Spindle Quantum</a>, where I build backend and optimization systems for a vehicle routing platform used in production logistics and fleet optimization.
                My work spans Operations Research, dynamic optimization, QUBO-based quantum optimization, and the infrastructure that ships it: Python services, CI/CD and Kubernetes on GCP.
            </p>
            <p>
                Outside work, I run <a href="https://careerbonus.co" target="_blank">CareerBonus</a>: short videos, guides and a free weekly newsletter on jobs and internships, startups, freelancing and AI.
            </p>
            <p>
                I graduated in April 2025 with an Integrated BS-MS in Data Science and Engineering from the
                <a href="https://www.iiserb.ac.in/" target="_blank">Indian Institute of Science Education and Research Bhopal</a>, where I worked with <a href="https://sites.google.com/view/vaibhavkumar1/home" target="_blank">Dr. Vaibhav Kumar</a> at the <a href="https://sites.google.com/iiserb.ac.in/geoai/home?authuser=0" target="_blank">GeoAI4Cities Lab</a> on 3D point clouds.
                Before that, I did research on 3D computer vision, adversarial robustness and machine learning through internships at IIT Delhi, Shiv Nadar Institute of Eminence, IIT (BHU) Varanasi and IIT Roorkee.
            </p>
<!--        <p>
                Previously, I've worked with <a href="https://snu.edu.in/faculty/prasun-kumar-roy/"  target="_blank">Dr. Prasun K. Roy</a> on  Securing Deep Neural Networks against Adversarial Attacks in MRI Imaging. This work got selected at NAMSON 2023, Bangalore.
            </p> -->
            <p>
                Feel free to check out my
                <a href="/data/Mayur_Mankar_Resume.pdf" target="_blank">resume</a>
                and drop me an
                <a href="mailto:mayurmankar.dev@gmail.com">e-mail</a>
                if you want to chat with me!
            </p>
            <p class="quick-links">
                ~&nbsp;
                <a href="mailto:mayurmankar.dev@gmail.com">Email</a> &nbsp;|&nbsp;
                <a href="/data/Mayur_Mankar_Resume.pdf" target="_blank">Resume</a> &nbsp;|&nbsp;
                <a href="https://careerbonus.co" target="_blank">CareerBonus</a> &nbsp;|&nbsp;
                <a href="https://www.researchgate.net/profile/Mayur-Mankar-2" target="_blank">ResearchGate</a> &nbsp;|&nbsp;
                <a href="https://github.com/mayurmankar-dev" target="_blank">Github</a> &nbsp;|&nbsp;
                <a href="https://www.linkedin.com/in/mayurmankar" target="_blank">LinkedIn</a> &nbsp;|&nbsp;
                <a href="https://x.com/mayurmankar_dev" target="_blank">X (Twitter)</a>
                &nbsp;~
            </p>
        </section>
        <hr class="soft">

<!-- Recent posts -->

        {recentPosts.length > 0 && (
            <Fragment>
                <section>
                    <h2 class="section-title">Recent Posts</h2>
                    <ul class="post-list">
                        {recentPosts.map((post) => (
                            <li>
                                <span class="post-date">{formatDate(post.data.date)}</span>
                                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                            </li>
                        ))}
                    </ul>

---
import { SITE_TITLE, SITE_DESCRIPTION, GA_MEASUREMENT_ID, CF_ANALYTICS_TOKEN } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;        // link-preview image path; defaults to the generated /og/default.png
  imageAlt?: string;
  imageSize?: { width: number; height: number };  // set when known (generated images are 1200×630)
  type?: 'website' | 'article';
  noindex?: boolean;     // keep this page out of search results
  fullTitle?: string;    // complete <title>, used as-is (e.g. the homepage)
  noCanonical?: boolean; // omit canonical/og:url (e.g. the 404 page, which has no real address)
  publishedTime?: Date;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = '/og/default.png',
  imageAlt = title ?? SITE_TITLE,
  imageSize = image.startsWith('/og/') ? { width: 1200, height: 630 } : undefined,
  type = 'website',
  publishedTime,
  noindex = false,
  fullTitle,
  noCanonical = false,
} = Astro.props;
const pageTitle = fullTitle ?? (title ? `${title} | ${SITE_TITLE}` : SITE_TITLE);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const isProd = import.meta.env.PROD;
---
<!DOCTYPE HTML>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{pageTitle}</title>
    <meta name="description" content={description}>
    <meta name="author" content="Mayur Mankar">
    {!noCanonical && <link rel="canonical" href={canonicalURL}>}

    <meta property="og:type" content={type}>
    <meta property="og:site_name" content={SITE_TITLE}>
    <meta property="og:title" content={fullTitle ?? title ?? SITE_TITLE}>
    <meta property="og:description" content={description}>
    {!noCanonical && <meta property="og:url" content={canonicalURL}>}
    <meta property="og:image" content={imageURL}>
    <meta property="og:image:alt" content={imageAlt}>
    {imageSize && <meta property="og:image:width" content={String(imageSize.width)}>}
    {imageSize && <meta property="og:image:height" content={String(imageSize.height)}>}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()}>}
    <meta name="twitter:card" content="summary_large_image">
    <!-- Lets Google show large image previews (e.g. in Discover) and full text snippets. -->
    <meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'}>
    <meta name="twitter:site" content="@mayurmankar_dev">

    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="sitemap" href="/sitemap-index.xml">
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} Blog`} href="/rss.xml">

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="/stylesheet.css">

    {isProd && CF_ANALYTICS_TOKEN && (
        <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}></script>
    )}
    {isProd && GA_MEASUREMENT_ID && (
        <Fragment>
            <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
            <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
                window.dataLayer = window.dataLayer || [];
                // Global, as in Google's official snippet (define:vars wraps this script in a function).
                window.gtag = function gtag(){dataLayer.push(arguments);};
                gtag('js', new Date());
                // No ads on this site, so don't collect advertising signals.
                gtag('config', GA_MEASUREMENT_ID, {
                    allow_google_signals: false,
                    allow_ad_personalization_signals: false
                });
            </script>
        </Fragment>
    )}
    <slot name="head" />
</head>
<body class="bg_colour">
    <main class="page">
        <slot />
        <footer class="site-footer">
            &copy; {new Date().getFullYear()} Mayur Mankar &nbsp;&middot;&nbsp;
            <a href="https://careerbonus.co" target="_blank">CareerBonus</a> &nbsp;&middot;&nbsp;
            <a href="/privacy/">Privacy</a> &nbsp;&middot;&nbsp;
            <a href="/rss.xml">RSS</a>
        </footer>
    </main>
</body>
</html>
